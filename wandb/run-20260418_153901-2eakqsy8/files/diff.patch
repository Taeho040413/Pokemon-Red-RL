+def _policy_tree_has_lazy_modules(root: nn.Module) -> bool:
+    """torch.compile(Dynamo) + Lazy*는 첫 추론 시 in_features를 틀리게 잡는 경우가 있어 비권장."""
+    for m in root.modules():
+        if isinstance(m, (nn.LazyLinear, nn.LazyConv2d)):
+            return True
+    return False
